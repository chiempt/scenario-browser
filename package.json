{
  "name": "scenario-browser",
  "version": "0.2.0",
  "description": "Run browser automation from small JSON or Markdown scenarios, with optional AI to write them and repair broken selectors.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=23.6"
  },
  "bin": {
    "scenario-browser": "dist/cli.js",
    "scenario-browser-mcp": "dist/mcp.js"
  },
  "files": [
    "dist",
    "portal",
    "examples",
    "scenario.schema.json",
    "scenario.project.schema.json",
    "README.md",
    "LICENSE",
    "!examples/**/reports"
  ],
  "scripts": {
    "cli": "node src/cli.ts",
    "portal": "node src/cli.ts portal",
    "validate": "node src/cli.ts validate examples",
    "schema": "node src/cli.ts schema > scenario.schema.json && node src/cli.ts schema project > scenario.project.schema.json",
    "typecheck": "tsc --noEmit",
    "browser:install": "cloakbrowser install",
    "test": "node --test --test-concurrency=1 \"test/*.test.ts\"",
    "check": "npm run typecheck && npm run build && npm test && npm run validate",
    "build": "tsc -p tsconfig.build.json",
    "prepare": "tsc -p tsconfig.build.json",
    "demo": "bash scripts/demo.sh",
    "bench:heal": "node bench/heal.ts"
  },
  "keywords": [
    "browser-automation",
    "playwright",
    "scenario",
    "e2e",
    "testing",
    "json",
    "markdown",
    "ai",
    "claude",
    "mcp",
    "model-context-protocol"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chiempt/scenario-browser.git"
  },
  "bugs": {
    "url": "https://github.com/chiempt/scenario-browser/issues"
  },
  "homepage": "https://github.com/chiempt/scenario-browser#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "cloakbrowser": "=0.5.10",
    "playwright-core": "^1.65.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
